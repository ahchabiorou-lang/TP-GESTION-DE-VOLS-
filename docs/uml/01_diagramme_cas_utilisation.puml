@startuml 01_diagramme_cas_utilisation
title Diagramme de cas d'utilisation - Agence de voyage de Cotonou
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor "Agent d'accueil" as Agent
actor "Client (site web)" as Client

rectangle "Systeme de gestion des vols et reservations" {
  usecase "Enregistrer un passager" as UC1
  usecase "Ajouter un vol" as UC2
  usecase "Afficher les vols disponibles" as UC3
  usecase "Rechercher un vol" as UC4
  usecase "Reserver un billet" as UC5
  usecase "Enregistrer un paiement" as UC6
  usecase "Annuler une reservation" as UC7
  usecase "Consulter les statistiques" as UC8
  usecase "Calculer le remboursement" as UC9
  usecase "Valider la reservation" as UC10
}

Agent --> UC1
Agent --> UC2
Agent --> UC3
Agent --> UC4
Agent --> UC5
Agent --> UC6
Agent --> UC7
Agent --> UC8
Client --> UC3
Client --> UC4
Client --> UC5

UC5 ..> UC1 : <<include>>\n(passager enregistre)
UC6 ..> UC10 : <<include>>
UC7 ..> UC9 : <<include>>
@enduml
